# SPDX-License-Identifier: GPL-2.0

# Enable available and selected Clang AutoFDO features.

CFLAGS_AUTOFDO_CLANG := -fdebug-info-for-profiling -mllvm -enable-fs-discriminator=true -mllvm -improved-fs-discriminator=true

ifndef CONFIG_DEBUG_INFO
  CFLAGS_AUTOFDO_CLANG += -gmlt
endif

ifeq ($(origin CLANG_AUTOFDO_PROFILE), undefined)
  ifeq ($(ARCH),arm64)
    ifneq ($(wildcard $(srctree)/gki/aarch64/afdo/kernel.afdo),)
      CLANG_AUTOFDO_PROFILE := $(abspath $(srctree)/gki/aarch64/afdo/kernel.afdo)
    endif
  endif
endif

ifneq ($(CLANG_AUTOFDO_PROFILE),)
  CFLAGS_AUTOFDO_CLANG += -fprofile-sample-use=$(CLANG_AUTOFDO_PROFILE) -ffunction-sections
  CFLAGS_AUTOFDO_CLANG += $(call cc-option,-fsplit-machine-functions)
endif

ifdef CONFIG_LTO_CLANG
  ifneq ($(CLANG_AUTOFDO_PROFILE),)
    KBUILD_LDFLAGS += --lto-sample-profile=$(CLANG_AUTOFDO_PROFILE)
    KBUILD_LDFLAGS += --mllvm=-split-machine-functions
  endif
  KBUILD_LDFLAGS += --mllvm=-enable-fs-discriminator=true --mllvm=-improved-fs-discriminator=true
  ifdef CONFIG_LTO_CLANG_THIN
    KBUILD_LDFLAGS += -plugin-opt=thinlto
  endif
endif

export CFLAGS_AUTOFDO_CLANG
